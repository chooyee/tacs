# Copy to .env and fill in the values marked TODO. Never commit .env (NFR-SEC-09).
# All variables are explained in docs/10-setup-config-deployment.md §2.

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
LOG_LEVEL=info
# TODO: 64 random hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-change-me-change-me-change-me-change-me-change-me-0000
# Secure cookies are only sent over HTTPS, so local http://localhost needs false. Production enforces true.
COOKIE_SECURE=false
# Number of proxies in front of the app (1 behind a load balancer). Empty locally.
TRUST_PROXY=

# --- Database ---
DATABASE_URL=postgres://psc:psc@localhost:5432/psc
DB_POOL_MAX=10

# --- Microsoft Entra ID (dev app registration, see docs/08 §1.1) ---
# TODO: from the dev app registration
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=TODO
# Production: use a certificate instead of the secret
# ENTRA_CERT_THUMBPRINT=
# ENTRA_CERT_PRIVATE_KEY_PATH=
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
ACCESS_REQUEST_TEXT=Ask the Architecture Office to give you access to Paper Standards Check.

# --- First local administrator (D-27). Created at startup when none exists; the password is
# temporary and must be changed at first sign-in (/auth/local). Remove these after the first start.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- AI (docs/07 §8). fake = no real AI calls. ---
AI_PROVIDER=fake
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# BEDROCK_REGION=ap-southeast-1
# BEDROCK_MODEL_ID=

# --- S3 / MinIO (used from M2) ---
# AWS_REGION=ap-southeast-1
# S3_BUCKET=psc-local
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
