{
  "name": "paper-standards-check",
  "version": "0.1.0",
  "private": true,
  "description": "Check a Solution Lab paper against the standards of its paper type.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build:css && node scripts/copyVendor.js",
    "build:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "start": "node src/server.js",
    "db:migrate": "node db/migrate.js",
    "admin": "node scripts/adminUser.js",
    "test": "node --env-file=tests/test.env --env-file-if-exists=tests/test.local.env --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:coverage": "node --env-file=tests/test.env --env-file-if-exists=tests/test.local.env --test --test-concurrency=1 --experimental-test-coverage \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "node db/seed/seed.js",
    "test:e2e": "npm run build && node --env-file=tests/test.env --env-file-if-exists=tests/test.local.env --test --test-concurrency=1 \"tests/e2e/**/*.e2e.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@azure/msal-node": "^7.0.1",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.1",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "basecoat-css": "^1.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pdfjs-dist": "^6.4.299",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.13.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3"
  }
}
