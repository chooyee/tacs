<%# First-start setup: create the first local administrator (D-27). %>
<section class="mx-auto max-w-md py-12">
  <div class="card p-6">
    <h1 class="text-xl font-semibold"><%= t.setup.title %></h1>
    <p class="mt-1 text-sm text-muted-foreground"><%= t.setup.intro %></p>
    <% if (error) { %><div class="alert-destructive mt-4" role="alert"><section><%= error %></section></div><% } %>
    <form method="post" action="/setup" class="form mt-4 grid gap-4" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <div class="grid gap-2">
        <label for="token"><%= t.setup.token %></label>
        <input class="input font-mono" id="token" name="token" required autofocus spellcheck="false">
        <p class="text-xs text-muted-foreground"><%= t.setup.tokenHelp %></p>
      </div>
      <div class="grid gap-2">
        <label for="username"><%= t.auth.username %></label>
        <input class="input" id="username" name="username" autocomplete="username" autocapitalize="none" required value="<%= username %>">
      </div>
      <div class="grid gap-2">
        <label for="password"><%= t.auth.password %></label>
        <input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength="12" required>
      </div>
      <div class="grid gap-2">
        <label for="confirm"><%= t.auth.confirmPassword %></label>
        <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="12" required>
      </div>
      <button type="submit" class="btn-primary w-full"><%= t.setup.submit %></button>
    </form>
  </div>
</section>
