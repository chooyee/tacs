<%# A local administrator replaces the temporary password before the first real sign-in (FR-ACC-10). %>
<section class="mx-auto max-w-sm py-12">
  <div class="card p-6">
    <h1 class="text-xl font-semibold"><%= t.auth.passwordTitle %></h1>
    <p class="mt-1 text-sm text-muted-foreground"><%= t.auth.passwordText %></p>
    <% if (error) { %><div class="alert mt-4" data-variant="destructive" role="alert"><section><%= error %></section></div><% } %>
    <form method="post" action="/auth/local/password" class="form mt-4 grid gap-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <div class="grid gap-2">
        <label for="password"><%= t.auth.newPassword %></label>
        <input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength="12" required autofocus>
      </div>
      <div class="grid gap-2">
        <label for="confirm"><%= t.auth.confirmPassword %></label>
        <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="12" required>
      </div>
      <button type="submit" class="btn w-full" data-variant="primary"><%= t.auth.savePassword %></button>
    </form>
  </div>
</section>
