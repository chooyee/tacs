<%# Local administrator sign-in (FR-ACC-10, D-27). %>
<form method="post" action="/auth/local" class="center-card" novalidate>
  <span class="brand-logo" aria-hidden="true"><%- include('../../partials/icon', { name: 'check', cls: 'size-5' }) %></span>
  <div>
    <h1 class="text-xl font-bold"><%= t.auth.localTitle %></h1>
    <p class="mt-1 text-[13px] text-muted-foreground"><%= t.auth.localText %></p>
  </div>
  <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
  <input type="hidden" name="returnTo" value="<%= returnTo %>">
  <div class="field">
    <label for="username"><%= t.auth.username %></label>
    <input class="input" type="text" id="username" name="username" autocomplete="username" autocapitalize="none" required value="<%= username %>" autofocus>
  </div>
  <div class="field">
    <label for="password"><%= t.auth.password %></label>
    <input class="input" id="password" name="password" type="password" autocomplete="current-password" required>
  </div>
  <button type="submit" class="btn w-full"><%= t.auth.signIn %></button>
  <p class="text-center text-[13px]"><a href="/auth/login"><%= t.auth.signInMicrosoft %></a></p>
</form>
