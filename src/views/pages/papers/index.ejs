<%# Papers home (docs/03 §3.1). M1: the empty state only; cards, New paper dialog and All papers come in M3. %>
<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-[22px] font-semibold leading-tight"><%= t.papers.heading %></h1>
    <p class="mt-1 text-muted-foreground"><%= t.papers.subtitle %></p>
  </div>
  <button type="button" class="btn" disabled title="<%= t.papers.comingSoon %>">+ <%= t.papers.newPaper %></button>
</div>

<nav class="tabs-nav mb-4" aria-label="<%= t.papers.heading %>">
  <a href="/papers" <% if (tab === 'mine') { %>aria-current="page"<% } %>><%= t.papers.tabMine %></a>
  <a href="/papers?tab=all" <% if (tab === 'all') { %>aria-current="page"<% } %>><%= t.papers.tabAll %></a>
</nav>

<% if (tab === 'all') { %>
<div class="panel empty-state"><p><%= t.papers.allComingSoon %></p></div>
<% } else if (!papers.length) { %>
<div class="panel empty-state">
  <h2 class="text-base font-semibold"><%= t.papers.emptyTitle %></h2>
  <p class="mt-1"><%= t.papers.emptyText %></p>
  <button type="button" class="btn mt-4" disabled title="<%= t.papers.comingSoon %>">+ <%= t.papers.newPaper %></button>
</div>
<% } %>
