<%# 403. ACCESS_NOT_GRANTED = disabled account (FR-ACC-03): explain how to request access. %>
<section class="mx-auto max-w-xl py-16 text-center">
  <% if (code === 'ACCESS_NOT_GRANTED') { %>
  <h1 class="text-2xl font-semibold"><%= t.errors.accessNotGrantedTitle %></h1>
  <p class="mt-3 text-muted-foreground"><%= message %></p>
  <p class="mt-3"><%= accessRequestText %></p>
  <% } else { %>
  <h1 class="text-2xl font-semibold"><%= t.errors.forbiddenTitle %></h1>
  <p class="mt-3 text-muted-foreground"><%= message %></p>
  <a class="btn mt-6" data-variant="outline" href="/"><%= t.errors.goHome %></a>
  <% } %>
  <% if (locals.requestId) { %>
  <p class="mt-4 text-xs text-muted-foreground"><%= t.errors.reference %>: <code><%= requestId.slice(0, 8) %></code></p>
  <% } %>
</section>
