<%# 403. ACCESS_NOT_GRANTED = disabled account (FR-ACC-03): explain how to request access. %>
<section class="message-page">
  <span class="badge-icon"><%- include('../partials/icon', { name: 'alert' }) %></span>
  <% if (code === 'ACCESS_NOT_GRANTED') { %>
  <h1 class="text-xl font-bold"><%= t.errors.accessNotGrantedTitle %></h1>
  <p class="text-muted-foreground"><%= message %></p>
  <p class="banner text-left"><%= accessRequestText %></p>
  <% } else { %>
  <h1 class="text-xl font-bold"><%= t.errors.forbiddenTitle %></h1>
  <p class="text-muted-foreground"><%= message %></p>
  <a class="btn mt-2" data-variant="outline" href="/"><%= t.errors.goHome %></a>
  <% } %>
  <% if (locals.requestId) { %>
  <p class="text-xs text-muted-foreground"><%= t.errors.reference %>: <code><%= requestId.slice(0, 8) %></code></p>
  <% } %>
</section>
