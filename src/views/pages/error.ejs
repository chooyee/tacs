<section class="mx-auto max-w-xl py-16 text-center">
  <h1 class="text-2xl font-semibold"><%= t.errors.errorTitle %></h1>
  <p class="mt-3 text-muted-foreground"><%= message %></p>
  <% if (locals.requestId) { %>
  <p class="mt-2 text-xs text-muted-foreground"><%= t.errors.reference %>: <code><%= requestId.slice(0, 8) %></code></p>
  <% } %>
  <a class="btn mt-6" data-variant="outline" href="/"><%= t.errors.goHome %></a>
</section>
