<section class="message-page">
  <span class="badge-icon"><%- include('../partials/icon', { name: 'alert' }) %></span>
  <h1 class="text-xl font-bold"><%= t.errors.errorTitle %></h1>
  <p class="text-muted-foreground"><%= message %></p>
  <% if (locals.requestId) { %>
  <p class="text-xs text-muted-foreground"><%= t.errors.reference %>: <code><%= requestId.slice(0, 8) %></code></p>
  <% } %>
  <a class="btn mt-2" data-variant="outline" href="/"><%= t.errors.goHome %></a>
</section>
