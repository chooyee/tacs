<%# Paper type editor (docs/03 §3.7, FR-ADM-10…21). Behaviour: public/js/pages/adminType.js.
    The two cards are partials, re-fetched from /admin/types/:id/cards/:card after each change. %>
<%- include('../../partials/admin/tabs') %>
<div id="type-editor" data-type-id="<%= type.id %>" data-strings="<%= JSON.stringify({
  saving: t.adminType.saving, saved: t.adminType.saved, notSaved: t.adminType.notSaved,
  undo: t.adminType.undo, deletedSection: t.adminType.deletedSection, deletedStandard: t.adminType.deletedStandard,
  deletedReference: t.adminType.deletedReference, newSection: t.adminType.newSection,
  confirmDeleteType: t.adminType.confirmDeleteType(type.name), addReference: t.adminType.referenceDialogAdd,
  editReference: t.adminType.referenceDialogEdit, fileHelp: t.adminType.fileHelp,
  fileReplaceHelp: t.adminType.fileReplaceHelp, addPlaceholder: t.adminType.addPlaceholder,
  addHint: t.adminType.addHint, done: t.adminType.done, addStandard: t.adminType.addStandard, tooMany: t.adminType.tooManyReferences
}) %>">
  <p class="mb-2 text-sm"><a href="/admin/types"><%= t.adminType.back %></a></p>

  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-60 flex-1">
      <input class="title-input" type="text" data-field="name" value="<%= type.name %>" maxlength="80" required
             aria-label="<%= t.adminType.namePlaceholder %>" placeholder="<%= t.adminType.namePlaceholder %>">
      <input class="sub-input" type="text" data-field="description" value="<%= type.description || '' %>" maxlength="300"
             aria-label="<%= t.adminType.descriptionPlaceholder %>" placeholder="<%= t.adminType.descriptionPlaceholder %>">
      <p class="save-status text-xs text-muted-foreground" aria-live="polite"></p>
    </div>
    <% if (papersInProgress > 0) { %>
    <span title="<%= t.adminType.inUse(papersInProgress) %>">
      <button type="button" class="btn" data-variant="outline" disabled aria-describedby="in-use-hint"><%= t.adminType.deleteType %></button>
      <span id="in-use-hint" class="sr-only"><%= t.adminType.inUse(papersInProgress) %></span>
    </span>
    <% } else { %>
    <button type="button" class="btn" data-variant="destructive" data-action="delete-type"><%= t.adminType.deleteType %></button>
    <% } %>
  </div>

  <div class="alert mb-4"><section><%= t.adminType.banner(type.name, papersInProgress) %></section></div>

  <div class="grid gap-4">
    <%- include('../../partials/admin/referencesCard') %>
    <%- include('../../partials/admin/standardsCard') %>
  </div>
</div>

<%- include('../../partials/admin/referenceDialog') %>
<%- include('../../partials/admin/standardDialog') %>
<%- include('../../partials/referenceViewer') %>
