<%# Paper types (docs/03 §3.6, FR-ADM-01/02, D-45). The dialog is driven by public/js/pages/adminTypes.js.
    Each card shows the newest published version (vN) and whether a draft is open. %>
<%- include('../../partials/admin/tabs') %>
<% const published = types.filter((type) => type.publishedNumber); %>
<div class="page-head">
  <div>
    <h1 class="page-title"><%= t.adminTypes.heading %></h1>
    <p class="page-sub"><%= t.adminTypes.subtitle %></p>
  </div>
  <button type="button" class="btn" data-action="new-type"><%- include('../../partials/icon', { name: 'plus' }) %> <%= t.adminTypes.newType %></button>
</div>

<div class="tile-grid">
  <% for (const type of types) { %>
  <a class="tile" href="/admin/types/<%= type.id %><%= type.publishedNumber ? '' : '/draft' %>">
    <div class="tile-top">
      <span class="tile-name"><%= type.name %></span>
      <span class="ttag"><%= t.adminTypes.papers(type.papersCount) %></span>
    </div>
    <div class="tile-versions">
      <% if (type.publishedNumber) { %>
      <span class="version-badge" data-status="published"><%= t.adminTypes.versionTag(type.publishedNumber) %></span>
      <% } else { %>
      <span class="version-badge" data-status="draft"><%= t.adminTypes.neverPublished %></span>
      <% } %>
      <% if (type.hasDraft && type.publishedNumber) { %>
      <span class="version-badge" data-status="draft"><%= t.adminTypes.draftInProgress %></span>
      <% } %>
    </div>
    <p class="tile-desc"><%= type.description || t.adminTypes.noDescription %></p>
    <div class="tile-meta">
      <span><b><%= type.standardsCount %></b> <%= t.adminTypes.standards %></span>
      <span><b><%= type.mandatoryCount %></b> <%= t.adminTypes.mandatory %></span>
      <span><b><%= type.referencesCount %></b> <%= t.adminTypes.references %></span>
    </div>
  </a>
  <% } %>
  <button type="button" class="tile tile-add" data-action="new-type">
    <span class="plus" aria-hidden="true">＋</span>
    <b><%= t.adminTypes.newType %></b>
    <span class="text-[13px] text-muted-foreground"><%= t.adminTypes.newTypeHint %></span>
  </button>
</div>

<dialog class="dialog" id="new-type-dialog" aria-labelledby="new-type-title">
  <form id="new-type-form" class="dlg" novalidate>
    <div class="dlg-head">
      <h2 id="new-type-title"><%= t.adminTypes.dialogTitle %></h2>
      <button type="button" class="icon-btn" data-action="close-dialog" aria-label="<%= t.viewer.close %>"><%- include('../../partials/icon', { name: 'close' }) %></button>
    </div>
    <div class="dlg-body">
      <div class="field">
        <label for="nt-name"><%= t.adminTypes.name %> <span class="req">*</span></label>
        <input class="input" type="text" id="nt-name" name="name" maxlength="80" required placeholder="<%= t.adminTypes.namePlaceholder %>">
      </div>
      <div class="field">
        <label for="nt-description"><%= t.adminTypes.description %></label>
        <textarea class="textarea" id="nt-description" name="description" maxlength="300" rows="2" placeholder="<%= t.adminTypes.descriptionPlaceholder %>"></textarea>
      </div>
      <fieldset class="field">
        <legend class="label mb-1.5"><%= t.adminTypes.startFrom %></legend>
        <div class="grid gap-2">
          <label class="check-card start-option">
            <input class="input" type="radio" name="copyFromTypeId" value="" checked>
            <span><b><%= t.adminTypes.blankTitle %></b><br><span class="text-[13px] text-muted-foreground"><%= t.adminTypes.blankHelp %></span></span>
          </label>
          <% if (published.length) { %>
          <label class="check-card start-option">
            <input class="input" type="radio" name="copyFromTypeId" value="copy">
            <span class="grid flex-1 gap-1.5">
              <span><b><%= t.adminTypes.copyTitle %></b><br><span class="text-[13px] text-muted-foreground"><%= t.adminTypes.copyHelp %></span></span>
              <select class="select w-full" id="nt-copy" aria-label="<%= t.adminTypes.copyTitle %>">
                <% for (const type of published) { %><option value="<%= type.id %>"><%= type.name %> · <%= t.adminTypes.versionTag(type.publishedNumber) %></option><% } %>
              </select>
            </span>
          </label>
          <% } %>
        </div>
      </fieldset>
      <p class="form-error" role="alert" hidden></p>
    </div>
    <div class="dlg-foot">
      <button type="button" class="btn" data-variant="outline" data-action="close-dialog"><%= t.adminTypes.cancel %></button>
      <button type="submit" class="btn"><%= t.adminTypes.create %></button>
    </div>
  </form>
</dialog>
