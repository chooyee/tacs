<%# Paper types (docs/03 §3.6, FR-ADM-01/02). The dialog is driven by public/js/pages/adminTypes.js. %>
<%- include('../../partials/admin/tabs') %>
<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-[22px] font-semibold leading-tight"><%= t.adminTypes.heading %></h1>
    <p class="mt-1 text-muted-foreground"><%= t.adminTypes.subtitle %></p>
  </div>
  <button type="button" class="btn" data-variant="primary" data-action="new-type">+ <%= t.adminTypes.newType %></button>
</div>

<div class="tile-grid">
  <% for (const type of types) { %>
  <a class="card tile" href="/admin/types/<%= type.id %>">
    <div class="flex items-start justify-between gap-2">
      <b><%= type.name %></b>
      <span class="badge" data-variant="outline"><%= t.adminTypes.papers(type.papersCount) %></span>
    </div>
    <p class="text-sm text-muted-foreground"><%= type.description || t.adminTypes.noDescription %></p>
    <div class="tile-meta">
      <span><b><%= type.standardsCount %></b> <%= t.adminTypes.standards %></span>
      <span><b><%= type.mandatoryCount %></b> <%= t.adminTypes.mandatory %></span>
      <span><b><%= type.referencesCount %></b> <%= t.adminTypes.references %></span>
    </div>
  </a>
  <% } %>
  <button type="button" class="card tile tile-add" data-action="new-type">
    <span class="text-2xl" aria-hidden="true">＋</span>
    <b><%= t.adminTypes.newType %></b>
    <span class="text-sm text-muted-foreground"><%= t.adminTypes.newTypeHint %></span>
  </button>
</div>

<dialog class="dialog" id="new-type-dialog" aria-labelledby="new-type-title">
  <div class="w-full sm:max-w-md">
    <header><h2 id="new-type-title"><%= t.adminTypes.dialogTitle %></h2></header>
    <form id="new-type-form" class="form grid gap-4" novalidate>
      <section class="grid gap-4">
        <div class="grid gap-2">
          <label for="nt-name"><%= t.adminTypes.name %> <span class="text-destructive">*</span></label>
          <input class="input" type="text" id="nt-name" name="name" maxlength="80" required placeholder="<%= t.adminTypes.namePlaceholder %>">
        </div>
        <div class="grid gap-2">
          <label for="nt-description"><%= t.adminTypes.description %></label>
          <textarea class="textarea" id="nt-description" name="description" maxlength="300" rows="2" placeholder="<%= t.adminTypes.descriptionPlaceholder %>"></textarea>
        </div>
        <div class="grid gap-2">
          <label for="nt-copy"><%= t.adminTypes.startFrom %></label>
          <select class="select w-full" id="nt-copy" name="copyFromTypeId">
            <option value=""><%= t.adminTypes.blank %></option>
            <% for (const type of types) { %>
            <option value="<%= type.id %>"><%= t.adminTypes.copyOf(type.name) %></option>
            <% } %>
          </select>
        </div>
        <p class="form-error text-sm text-destructive" role="alert" hidden></p>
      </section>
      <footer class="gap-2">
        <button type="button" class="btn" data-variant="outline" data-action="close-dialog"><%= t.adminTypes.cancel %></button>
        <button type="submit" class="btn" data-variant="primary"><%= t.adminTypes.create %></button>
      </footer>
    </form>
    <button type="button" aria-label="<%= t.viewer.close %>" data-action="close-dialog" class="top-3 right-3">✕</button>
  </div>
</dialog>
