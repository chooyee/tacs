<%# Admin → References: the shared library (D-37). Behaviour: public/js/pages/adminReferences.js. %>
<%- include('../../partials/admin/tabs') %>
<div class="page-head">
  <div>
    <h1 class="page-title"><%= t.library.heading %> <span class="count align-middle"><%= references.length %></span></h1>
    <p class="page-sub max-w-3xl"><%= t.library.subtitle %></p>
  </div>
  <a class="btn" href="/admin/references/new"><%- include('../../partials/icon', { name: 'plus' }) %> <%= t.library.add %></a>
</div>

<% if (!references.length) { %>
<div class="panel empty"><%= t.library.empty %></div>
<% } else { %>
<div class="mb-3 flex flex-wrap gap-2" id="library-filters">
  <label class="relative min-w-60 flex-1">
    <span class="sr-only"><%= t.library.search %></span>
    <span class="pointer-events-none absolute top-1/2 left-2.5 -translate-y-1/2 text-muted-foreground"><%- include('../../partials/icon', { name: 'search' }) %></span>
    <input class="input w-full pl-8" type="search" id="library-search" placeholder="<%= t.library.search %>">
  </label>
  <div class="seg" role="group" aria-label="<%= t.adminType.type %>">
    <button type="button" aria-pressed="true" data-type=""><%= t.library.allTypes %></button>
    <% for (const type of t.referenceTypes) { %><button type="button" aria-pressed="false" data-type="<%= type %>"><span aria-hidden="true"><%= t.referenceIcons[type] %></span> <%= type %></button><% } %>
  </div>
</div>

<div class="panel" id="library-list">
  <% for (const r of references) { %>
  <div class="ref-row" data-reference-id="<%= r.id %>" data-type="<%= r.type %>" data-search="<%= `${r.title} ${r.type} ${r.note || ''}`.toLowerCase() %>">
    <span class="ref-icon" aria-hidden="true"><%= t.referenceIcons[r.type] %></span>
    <div class="ref-main">
      <a class="ref-title block text-foreground" href="/admin/references/<%= r.id %>"><%= r.title %> <span class="ttag"><%= r.type %></span></a>
      <div class="ref-note" title="<%= r.note || '' %>"><%= r.note || t.adminType.noNote %></div>
      <div class="ref-meta"><%= t.library.usage(r.linkedCount, r.typeCount) %> · <%- include('../../partials/edited', { at: r.updatedAt, by: r.updatedBy }) %></div>
    </div>
    <div class="row-actions">
      <button type="button" class="icon-btn" data-action="view-reference" aria-label="<%= t.library.preview %>: <%= r.title %>" title="<%= t.library.preview %>"><%- include('../../partials/icon', { name: 'eye' }) %></button>
      <a class="icon-btn" href="/admin/references/<%= r.id %>" aria-label="<%= t.adminType.edit %>: <%= r.title %>" title="<%= t.adminType.edit %>"><%- include('../../partials/icon', { name: 'pencil' }) %></a>
      <button type="button" class="icon-btn danger" data-action="delete-reference" aria-label="<%= t.library.delete %>: <%= r.title %>" title="<%= t.library.delete %>"><%- include('../../partials/icon', { name: 'trash' }) %></button>
    </div>
  </div>
  <% } %>
  <p class="empty hidden" id="library-no-match"><%= t.library.noMatch %></p>
</div>
<% } %>
<div hidden id="library-strings" data-json="<%= JSON.stringify({ deleted: t.library.deleted, undo: t.adminType.undo }) %>"></div>
<%- include('../../partials/referenceViewer') %>
