<%# The fields of a library reference (FR-ADM-12, D-37): type cards, title, file drop zone, intranet
    link, rich-text guidance. Used by the full-screen reference page and by the "New reference"
    panel of the standard form. `p` = id prefix, `ref` = the reference being edited (or null). %>
<fieldset class="field">
  <legend class="label mb-1.5"><%= t.adminType.type %></legend>
  <div class="choose">
    <% t.referenceTypes.forEach((type, i) => { %>
    <label class="choice">
      <input type="radio" name="type" value="<%= type %>" <% if (ref ? ref.type === type : i === 0) { %>checked<% } %>>
      <span class="emoji" aria-hidden="true"><%= t.referenceIcons[type] %></span>
      <span><%= type %></span>
    </label>
    <% }) %>
  </div>
</fieldset>
<div class="field">
  <label for="<%= p %>-title"><%= t.adminType.title %> <span class="req">*</span></label>
  <input class="input" type="text" id="<%= p %>-title" name="title" maxlength="200" required value="<%= ref ? ref.title : '' %>" placeholder="<%= t.adminType.titlePlaceholder %>">
</div>
<div class="field">
  <span class="label"><%= t.library.file %> <% if (!ref) { %><span class="req">*</span><% } %></span>
  <% if (ref) { %>
  <div class="current-file">
    <%- include('../icon', { name: 'file' }) %>
    <span class="min-w-0 flex-1 truncate"><b><%= ref.fileName %></b> · <%= (ref.sizeBytes / 1024 / 1024).toFixed(1) %> MB<% if (ref.pageCount) { %> · <%= ref.pageCount %> pages<% } %></span>
    <button type="button" class="link-btn" data-action="view-reference" data-reference-id="<%= ref.id %>"><%- include('../icon', { name: 'eye' }) %> <%= t.library.preview %></button>
  </div>
  <% } %>
  <div><label class="dropzone" for="<%= p %>-file">
    <input type="file" id="<%= p %>-file" name="file" accept="application/pdf,image/png,image/jpeg">
    <%- include('../icon', { name: 'upload' }) %>
    <span class="file-name" data-empty="<%= ref ? t.library.replaceFile : t.adminType.chooseFile %>"><%= ref ? t.library.replaceFile : t.adminType.chooseFile %></span>
    <span class="help"><%= t.adminType.fileHelp %></span>
  </label></div>
</div>
<div class="field">
  <label for="<%= p %>-url"><%= t.adminType.link %></label>
  <input class="input" type="url" id="<%= p %>-url" name="url" maxlength="2000" value="<%= ref && ref.url ? ref.url : '' %>" placeholder="<%= t.adminType.linkPlaceholder %>">
</div>
<div class="field">
  <span class="label" id="<%= p %>-guidance-label"><%= t.library.guidance %></span>
  <div class="rich-editor full" id="<%= p %>-guidance" data-html="<%= ref ? ref.guidanceHtml : '' %>"
       data-placeholder="<%= t.library.guidancePlaceholder %>" aria-labelledby="<%= p %>-guidance-label"></div>
  <span class="help"><%= t.library.guidanceHelp %></span>
</div>
