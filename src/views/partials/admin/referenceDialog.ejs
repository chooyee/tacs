<%# Add / Edit reference (FR-ADM-12). Sent as multipart/form-data by adminType.js. %>
<dialog class="dialog" id="reference-dialog" aria-labelledby="reference-dialog-title">
  <form id="reference-form" class="dlg" novalidate>
    <div class="dlg-head">
      <h2 id="reference-dialog-title"><%= t.adminType.referenceDialogAdd %></h2>
      <button type="button" class="icon-btn" data-action="close-dialog" aria-label="<%= t.viewer.close %>"><%- include('../icon', { name: 'close' }) %></button>
    </div>
    <div class="dlg-body">
      <fieldset class="field">
        <legend class="label mb-1.5"><%= t.adminType.type %></legend>
        <div class="choose">
          <% t.referenceTypes.forEach((type, i) => { %>
          <label class="choice">
            <input type="radio" name="type" value="<%= type %>" <% if (i === 0) { %>checked<% } %>>
            <span class="emoji" aria-hidden="true"><%= t.referenceIcons[type] %></span>
            <span><%= type %></span>
          </label>
          <% }) %>
        </div>
      </fieldset>
      <div class="field">
        <label for="rf-title"><%= t.adminType.title %> <span class="req">*</span></label>
        <input class="input" type="text" id="rf-title" name="title" maxlength="200" required placeholder="<%= t.adminType.titlePlaceholder %>">
      </div>
      <div class="field">
        <span class="label"><%= t.adminType.file %> <span class="req file-required">*</span></span>
        <div><label class="dropzone" for="rf-file">
          <input type="file" id="rf-file" name="file" accept="application/pdf,image/png,image/jpeg">
          <%- include('../icon', { name: 'upload' }) %>
          <span class="file-name"><%= t.adminType.chooseFile %></span>
          <span class="file-help help"><%= t.adminType.fileHelp %></span>
        </label></div>
      </div>
      <div class="field">
        <label for="rf-url"><%= t.adminType.link %></label>
        <input class="input" type="url" id="rf-url" name="url" maxlength="2000" placeholder="<%= t.adminType.linkPlaceholder %>">
      </div>
      <div class="field">
        <label for="rf-note"><%= t.adminType.note %></label>
        <textarea class="textarea" id="rf-note" name="note" maxlength="500" rows="3" placeholder="<%= t.adminType.notePlaceholder %>" data-counter></textarea>
        <span class="counter" aria-hidden="true"></span>
      </div>
      <p class="form-error" role="alert" hidden></p>
    </div>
    <div class="dlg-foot">
      <button type="button" class="btn" data-variant="outline" data-action="close-dialog"><%= t.adminType.cancel %></button>
      <button type="submit" class="btn"><%= t.adminType.save %></button>
    </div>
  </form>
</dialog>
