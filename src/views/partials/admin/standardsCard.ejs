<%# Standards card (FR-ADM-14…19). The inline "add standard" box is created by adminType.js. %>
<section class="panel" id="standards-card">
  <div class="card-head">
    <div>
      <h2 class="text-base font-semibold"><%= t.adminType.standardsTitle %></h2>
      <p class="text-sm text-muted-foreground"><%= t.adminType.standardsHelp(totals.standards, totals.sections) %></p>
    </div>
    <button type="button" class="btn" data-variant="outline" data-size="sm" data-action="add-section">＋ <%= t.adminType.addSection %></button>
  </div>
  <% if (!sections.length) { %>
  <p class="empty-state"><%= t.adminType.noSections %></p>
  <% } %>
  <% sections.forEach((section, si) => { %>
  <div class="admin-section" data-section-id="<%= section.id %>">
    <div class="section-head">
      <span class="section-letter"><%= section.letter %></span>
      <input class="section-title" type="text" value="<%= section.title %>" maxlength="150" required
             aria-label="<%= t.adminType.sectionTitle(section.letter) %>">
      <span class="count-pill"><%= section.standards.length %></span>
      <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" data-action="move-section" data-direction="up" <% if (si === 0) { %>disabled<% } %> aria-label="<%= t.adminType.moveUp %>" title="<%= t.adminType.moveUp %>">↑</button>
      <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" data-action="move-section" data-direction="down" <% if (si === sections.length - 1) { %>disabled<% } %> aria-label="<%= t.adminType.moveDown %>" title="<%= t.adminType.moveDown %>">↓</button>
      <button type="button" class="btn danger" data-variant="ghost" data-size="icon-sm" data-action="delete-section" aria-label="<%= t.adminType.deleteSection %>" title="<%= t.adminType.deleteSection %>">🗑</button>
    </div>
    <% section.standards.forEach((s, ki) => { %>
    <div class="admin-row standard-row" data-standard-id="<%= s.id %>" data-text="<%= s.text %>"
         data-mandatory="<%= s.isMandatory %>" data-reference-ids="<%= s.references.map((r) => r.id).join(',') %>">
      <span class="std-number"><%= s.number %></span>
      <div class="min-w-0 flex-1">
        <div>
          <%= s.text %>
          <button type="button" class="mandatory-toggle" data-action="toggle-mandatory" aria-pressed="<%= s.isMandatory %>" title="<%= t.adminType.toggleHint %>"><%= s.isMandatory ? t.adminType.mandatory : t.adminType.optional %></button>
        </div>
        <div class="ref-chips">
          <% for (const r of s.references) { %>
          <button type="button" class="ref-chip" data-action="view-reference" data-reference-id="<%= r.id %>" title="<%= r.note || r.title %>">
            <span aria-hidden="true"><%= t.referenceIcons[r.type] %></span> <%= r.title %>
          </button>
          <% } %>
          <button type="button" class="ref-chip ref-chip-add" data-action="edit-standard"><%= s.references.length ? t.adminType.editLinks : t.adminType.linkReference %></button>
        </div>
      </div>
      <div class="row-actions">
        <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" data-action="edit-standard" aria-label="<%= t.adminType.edit %> #<%= s.number %>" title="<%= t.adminType.edit %>">✎</button>
        <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" data-action="move-standard" data-direction="up" <% if (ki === 0) { %>disabled<% } %> aria-label="<%= t.adminType.moveUp %> #<%= s.number %>" title="<%= t.adminType.moveUp %>">↑</button>
        <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" data-action="move-standard" data-direction="down" <% if (ki === section.standards.length - 1) { %>disabled<% } %> aria-label="<%= t.adminType.moveDown %> #<%= s.number %>" title="<%= t.adminType.moveDown %>">↓</button>
        <button type="button" class="btn danger" data-variant="ghost" data-size="icon-sm" data-action="delete-standard" aria-label="<%= t.adminType.delete %> #<%= s.number %>" title="<%= t.adminType.delete %>">🗑</button>
      </div>
    </div>
    <% }) %>
    <div class="add-slot">
      <button type="button" class="add-link" data-action="open-add"><%= t.adminType.addStandard %></button>
    </div>
  </div>
  <% }) %>
</section>
