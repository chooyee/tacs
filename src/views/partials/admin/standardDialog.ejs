<%# Edit standard (FR-ADM-17): text, mandatory, linked references (checkboxes built by adminType.js). %>
<dialog class="dialog" id="standard-dialog" aria-labelledby="standard-dialog-title">
  <div class="w-full sm:max-w-lg">
    <header><h2 id="standard-dialog-title"><%= t.adminType.standardDialog %></h2></header>
    <form id="standard-form" class="form grid gap-4" novalidate>
      <section class="grid gap-4">
        <div class="grid gap-2">
          <label for="sf-text"><%= t.adminType.standardText %> <span class="text-destructive">*</span></label>
          <textarea class="textarea" id="sf-text" name="text" maxlength="500" rows="3" required></textarea>
        </div>
        <label class="flex items-start gap-2">
          <input class="input" type="checkbox" id="sf-mandatory" name="isMandatory">
          <span><b><%= t.adminType.mandatoryLabel %></b><br><span class="text-sm text-muted-foreground"><%= t.adminType.mandatoryHelp %></span></span>
        </label>
        <fieldset class="grid gap-2">
          <legend class="mb-1 font-medium"><%= t.adminType.linkedReferences %></legend>
          <div id="sf-references" class="grid gap-1"></div>
          <p class="too-many text-sm text-warn" hidden><%= t.adminType.tooManyReferences %></p>
        </fieldset>
        <p class="form-error text-sm text-destructive" role="alert" hidden></p>
      </section>
      <footer class="gap-2">
        <button type="button" class="btn" data-variant="outline" data-action="close-dialog"><%= t.adminType.cancel %></button>
        <button type="submit" class="btn" data-variant="primary"><%= t.adminType.save %></button>
      </footer>
    </form>
    <button type="button" aria-label="<%= t.viewer.close %>" data-action="close-dialog" class="top-3 right-3">✕</button>
  </div>
</dialog>
