<%# "References used here" (FR-ADM-11, D-37): the library references this type's standards link to.
    References are added and edited in the shared library (Admin → References). %>
<section class="panel scroll-target" id="references-card" data-jump-label="<%= t.adminType.referencesTitle %>" data-jump-count="<%= usedReferences.length %>">
  <div class="panel-head">
    <div>
      <h2 class="panel-title"><%= t.adminType.referencesTitle %> <span class="count"><%= usedReferences.length %></span></h2>
      <p class="panel-sub"><%= t.adminType.libraryHint %></p>
    </div>
    <a class="btn" data-variant="outline" data-size="sm" href="/admin/references">
      <%- include('../icon', { name: 'file' }) %> <%= t.adminType.manageLibrary %>
    </a>
  </div>
  <% if (!usedReferences.length) { %>
  <p class="empty border-t"><%= t.adminType.noReferences %></p>
  <% } %>
  <% for (const r of usedReferences) { %>
  <div class="ref-row" data-reference-id="<%= r.id %>">
    <span class="ref-icon" aria-hidden="true"><%= t.referenceIcons[r.type] %></span>
    <div class="ref-main">
      <div class="ref-title"><%= r.title %> <span class="ttag"><%= r.type %></span></div>
      <div class="ref-note" title="<%= r.note || '' %>"><%= r.note || t.adminType.noNote %></div>
    </div>
    <span class="ref-linked"><%= t.adminType.linkedHere(r.linkedCount) %></span>
    <div class="row-actions">
      <button type="button" class="icon-btn" data-action="view-reference" aria-label="<%= t.adminType.preview %>: <%= r.title %>" title="<%= t.adminType.preview %>"><%- include('../icon', { name: 'eye' }) %></button>
      <a class="icon-btn" href="/admin/references/<%= r.id %>" aria-label="<%= t.adminType.edit %>: <%= r.title %>" title="<%= t.adminType.edit %>"><%- include('../icon', { name: 'pencil' }) %></a>
    </div>
  </div>
  <% } %>
</section>
